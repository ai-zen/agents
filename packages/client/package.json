{
  "name": "@ai-zen/agents-client",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "AI-Zen Agents Client — 到 agents-server 的连接层：本地拉起/发现服务端、连接设置、JSON-RPC 调用与事件、重连补拉。cli 与 desktop 各自把它捆进自己的产物",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "clean": "rimraf ./dist",
    "prebuild": "npm run clean",
    "build": "tsc",
    "pretest": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:all": "npm run pretest && vitest run && npm run build"
  },
  "author": "LZQCN",
  "license": "MIT",
  "dependencies": {
    "@ai-zen/agents-core": "workspace:^"
  },
  "devDependencies": {
    "@ai-zen/agents-sdk": "workspace:*",
    "@ai-zen/agents-server": "workspace:*",
    "@ai-zen/agents-testing": "workspace:*",
    "@types/node": "^24.12.2",
    "rimraf": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
