{
  "name": "@ai-zen/agents-client",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "AI-Zen Agents Client — 到 agents-host 的连接层：一条 tRPC over WebSocket 的连接、本地拉起/发现宿主、连接设置、重连、素材上传与取回。cli 与 desktop 各自把它捆进自己的产物",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "clean": "rimraf ./dist",
    "prebuild": "npm run clean",
    "build": "tsc",
    "pretest": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:all": "npm run pretest && vitest run && npm run build"
  },
  "author": "LZQCN",
  "license": "MIT",
  "dependencies": {
    "@ai-zen/agents-core": "workspace:^",
    "@trpc/client": "^11.29.5"
  },
  "devDependencies": {
    "@ai-zen/agents-host": "workspace:*",
    "@ai-zen/agents-sdk": "workspace:*",
    "@ai-zen/fake-llm": "workspace:*",
    "@types/node": "^24.12.2",
    "rimraf": "^6.1.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
