{
  "name": "@ai-zen/agents-sdk",
  "version": "1.2.0-alpha.0",
  "description": "AI-Zen Agents SDK — shared business logic for CLI and Desktop",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-zen/agents.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/ai-zen/agents/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/ai-zen/agents/issues"
  },
  "scripts": {
    "clean": "rimraf ./dist",
    "prebuild": "npm run clean",
    "build": "tsc",
    "prepublishOnly": "node scripts/check-publish-tool.mjs && npm test && npm run build",
    "format": "prettier --write --ignore-path ../../.prettierignore .",
    "format:check": "prettier --check --ignore-path ../../.prettierignore .",
    "pretest": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:e2e": "npm run pretest && vitest run --config vitest.e2e.config.ts",
    "test:all": "npm run pretest && vitest run && npm run build && vitest run --config vitest.e2e.config.ts"
  },
  "keywords": [
    "ai",
    "agent",
    "sdk",
    "llm",
    "mcp",
    "model-context-protocol"
  ],
  "author": "LZQCN",
  "license": "MIT",
  "dependencies": {
    "@ai-zen/agents-core": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "openai": "^7.5.0"
  },
  "devDependencies": {
    "@ai-zen/agents-testing": "workspace:*",
    "@types/node": "^24.12.2",
    "dotenv": "^17.4.2",
    "prettier": "^3.9.5",
    "rimraf": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ]
}
