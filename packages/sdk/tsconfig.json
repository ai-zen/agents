{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    // 显式声明全局类型：TypeScript 7 不再自动从 node_modules/@types 收集（至少在本仓的
    // pnpm 软链布局下收不到），不写这行 "node:fs"/"process" 全是 TS2591。
    "types": ["node"]
  },
  "include": ["src"],
  // `src/test-support/` 只被用例引用：从**生产构建**里排除，免得它跟着 `files: ["dist"]`
  // 一起发出去（`tsconfig.test.json` 覆盖了 `exclude`，用例那边照样参与类型检查）。
  // 与 `cli/tsconfig.json` 同一条规则。
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.test.tsx", "src/test-support"]
}
