{
  // 测试代码的类型检查配置：`tsconfig.json` 把 **/*.test.ts 排除在生产构建之外，
  // 于是用例里的调用长期不参与类型检查。这里单独一份：只做 noEmit 检查，不产出任何文件。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // 用例与 src 同在根目录下，根目录必须是包根，否则会被 rootDir=./src 拒绝
    "rootDir": "."
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
