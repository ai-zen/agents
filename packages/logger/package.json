{
  "name": "@ai-zen/agents-logger",
  "version": "0.1.0-alpha.0",
  "description": "AI-Zen Agents Logger — one process, one log file (zero dependencies)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-zen/agents.git",
    "directory": "packages/logger"
  },
  "homepage": "https://github.com/ai-zen/agents/tree/main/packages/logger#readme",
  "bugs": {
    "url": "https://github.com/ai-zen/agents/issues"
  },
  "scripts": {
    "clean": "rimraf ./dist",
    "prebuild": "npm run clean",
    "build": "tsc",
    "prepublishOnly": "node scripts/check-publish-tool.mjs && npm test && npm run build",
    "format": "prettier --write --ignore-path ../../.prettierignore .",
    "format:check": "prettier --check --ignore-path ../../.prettierignore .",
    "pretest": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "keywords": [
    "ai",
    "agent",
    "log",
    "logger",
    "rotating-file"
  ],
  "author": "LZQCN",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.12.2",
    "rimraf": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "files": [
    "dist"
  ]
}
