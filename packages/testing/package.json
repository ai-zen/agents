{
  "name": "@ai-zen/agents-testing",
  "version": "0.1.0",
  "private": true,
  "description": "Test doubles shared by the AI-Zen Agents packages: a fake OpenAI-compatible streaming endpoint",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "clean": "rimraf ./dist",
    "prebuild": "npm run clean",
    "build": "tsc",
